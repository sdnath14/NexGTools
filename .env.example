OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_this_local_password
MYSQL_DATABASE=nextgtools
ADMIN_PASSWORD=your_admin_password
DEFAULT_LOGIN_EMAIL=Admin@nexgpetrolube.com
DEFAULT_LOGIN_PASSWORD=change_this_default_login_password
DOCUMENT_STORAGE_DIRECTORY=/var/lib/nexgtools/documents
CHROMA_PERSIST_DIRECTORY=/var/lib/nexgtools/chroma
CHROMA_COLLECTION_NAME=document_records
DOCUMENT_MAX_UPLOAD_MB=100

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_sender@example.com
SMTP_USE_TLS=false
