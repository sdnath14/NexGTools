{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MySQL: Start",
      "type": "shell",
      "command": "docker compose up -d --wait mysql",
      "problemMatcher": []
    },
    {
      "label": "MySQL: Stop",
      "type": "shell",
      "command": "docker compose stop mysql",
      "problemMatcher": []
    },
    {
      "label": "Backend: Start",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "dependsOn": ["MySQL: Start"],
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start",
      "type": "npm",
      "script": "dev",
      "problemMatcher": []
    },
    {
      "label": "NexGTools: Start all",
      "dependsOrder": "parallel",
      "dependsOn": ["Backend: Start", "Frontend: Start"],
      "problemMatcher": []
    }
  ]
}
